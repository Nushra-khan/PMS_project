# Copy this file to .env.local and fill in real values. Never commit real secrets.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase service role key. Only needed for privileged jobs.
# SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string used by the server and the db:* scripts
DATABASE_URL=

# Run user requests as Supabase's "authenticated" role so row-level security
# applies. Apply every migration in supabase/migrations first (see README).
DB_ENFORCE_RLS=false

# App
APP_URL=http://localhost:3000
# Shared secret the cron caller sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Email via Resend (optional; SMTP below is used when this is empty)
RESEND_API_KEY=
EMAIL_FROM=no-reply@pms.local

# Email via SMTP. 54325 is the local Supabase Inbucket port; use your
# provider's port (usually 587 or 465) in production. Not the Postgres port.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_EMAIL=no-reply@pms.local
SMTP_FROM_NAME=PMS
EMAIL_BATCH_SIZE=25
